# Exemplo de variáveis de ambiente para desenvolvimento
SECRET_KEY=troque_esta_chave
DEBUG=False

# Postgres (individual vars)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Or set a single DATABASE_URL (used by Vercel Postgres), ex:
# DATABASE_URL=postgres://user:password@host:5432/dbname
